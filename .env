# Local development defaults. bin/setup creates private .env.local secrets.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=
DATABASE_URL="postgresql://xorgate:xorgate_local@database:5432/xorgate?serverVersion=17&charset=utf8"
MESSENGER_TRANSPORT_DSN="doctrine://default?auto_setup=false"
XORGATE_ARTIFACT_DIR=/var/lib/xorgate/artifacts
XORGATE_MCP_TOKEN=
XORGATE_PROBE_MAX_PENDING=100
XORGATE_PROBE_MAX_RETAINED=1000
XORGATE_PROBE_MAX_PER_MINUTE=30
XORGATE_PROBE_ARTIFACT_RETENTION_SECONDS=604800
XORGATE_PROBE_RECORD_RETENTION_SECONDS=1209600
XORGATE_REGISTRY_MAX_PROJECTS=1000
XORGATE_REGISTRY_MAX_EXECUTIONS=10000
XORGATE_REGISTRY_MAX_REQUESTS=20000
XORGATE_REGISTRY_MAX_PER_MINUTE=120
