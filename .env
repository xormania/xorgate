# Local development defaults. bin/setup creates private .env.local secrets.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=
DATABASE_URL="postgresql://xorgate:xorgate_local@database:5432/xorgate?serverVersion=17&charset=utf8"
MESSENGER_TRANSPORT_DSN="doctrine://default?auto_setup=false"
XORGATE_ARTIFACT_DIR=/var/lib/xorgate/artifacts
XORGATE_MCP_TOKEN=
