{
    "name": "xormania/xorgate",
    "description": "Language-neutral testing and CI management foundation",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-zip": "*",
        "doctrine/dbal": "^4.3",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.5",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.11",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mcp-bundle": "^0.14.1",
        "symfony/messenger": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/process": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/stimulus-bundle": "^3.5",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/ux-icons": "^3.5",
        "symfony/ux-live-component": "^3.5",
        "symfony/ux-turbo": "^3.5",
        "symfony/ux-twig-component": "^3.5",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "symfonycasts/tailwind-bundle": "^1.0",
        "tales-from-a-dev/twig-tailwind-extra": "^1.5",
        "twig/extra-bundle": "^3.29",
        "twig/html-extra": "^3.29"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/maker-bundle": "^1.65",
        "symfony/ux-toolkit": "3.5.1"
    },
    "autoload": { "psr-4": { "App\\": "src/" } },
    "autoload-dev": { "psr-4": { "App\\Tests\\": "tests/" } },
    "config": {
        "allow-plugins": { "php-http/discovery": true, "symfony/flex": true, "symfony/runtime": true },
        "sort-packages": true,
        "preferred-install": "dist",
        "source-fallback": false
    },
    "scripts": {
        "auto-scripts": { "cache:clear": "symfony-cmd", "assets:install %PUBLIC_DIR%": "symfony-cmd", "importmap:install": "symfony-cmd" },
        "post-install-cmd": ["@auto-scripts"],
        "post-update-cmd": ["@auto-scripts"]
    },
    "conflict": { "symfony/symfony": "*" },
    "extra": { "symfony": { "allow-contrib": true, "require": "8.1.*", "docker": false } }
}
