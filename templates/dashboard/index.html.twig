{% extends 'layouts/app.html.twig' %}

{% block title %}Xorgate · Overview{% endblock %}
{% block brand %}
    <a href="{{ path('app_dashboard') }}" class="font-semibold tracking-tight text-heading">Xorgate</a>
{% endblock %}
{% block sidebar %}
    <twig:Sidebar:Group label="Management">
        <twig:Sidebar:Item href="{{ path('app_dashboard') }}" route="app_dashboard">Overview</twig:Sidebar:Item>
    </twig:Sidebar:Group>
{% endblock %}
{% block page_title %}Overview{% endblock %}
{% block page_description %}The foundation for testing and CI management across projects, languages and tools.{% endblock %}
{% block content %}
    <div class="space-y-6">
        <section aria-labelledby="foundation-heading" class="rounded-xl border border-default bg-neutral-primary p-5 md:p-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                    <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-body">Application foundation</p>
                    <h2 id="foundation-heading" class="text-xl font-semibold text-heading">Persistent services, shared interfaces</h2>
                    <p class="mt-2 max-w-3xl text-sm text-body">This page reports the same runtime checks exposed to agents through MCP. Project registration, test adapters and coverage assessments will build on these services.</p>
                </div>
                <span data-xorgate-foundation data-xorgate-foundation-status="{{ foundation.ready ? 'ready' : 'unavailable' }}" class="rounded-full border border-default bg-neutral-secondary-soft px-3 py-1 text-sm font-medium text-heading">
                    {{ foundation.ready ? 'Foundation ready' : 'Attention required' }}
                </span>
            </div>

            <dl class="mt-6 grid gap-4 sm:grid-cols-3">
                {% set check_labels = {database: 'Database', artifacts: 'Artifact storage', queue: 'Async queue'} %}
                {% for key, check in foundation.checks %}
                    <div class="rounded-lg border border-default p-4" data-xorgate-check="{{ key }}">
                        <dt class="text-sm font-semibold text-heading">{{ check_labels[key] }}</dt>
                        <dd class="mt-2">
                            <span class="text-sm font-medium text-heading">{{ check.status == 'ready' ? 'Ready' : 'Unavailable' }}</span>
                            <p class="mt-1 text-sm text-body">{{ check.detail }}</p>
                        </dd>
                    </div>
                {% endfor %}
            </dl>

            <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 border-t border-default pt-4 text-xs text-body">
                <span>Symfony {{ foundation.application.framework }}</span>
                <span>Environment: {{ foundation.application.environment }}</span>
                <span>Observed <time datetime="{{ foundation.observed_at }}">{{ foundation.observed_at }}</time></span>
            </div>
        </section>

        <div class="grid gap-6 lg:grid-cols-2">
            <section aria-labelledby="evidence-heading" class="rounded-xl border border-default bg-neutral-primary p-5 md:p-6">
                <h2 id="evidence-heading" class="text-lg font-semibold text-heading">Evidence and system coverage</h2>
                <p class="mt-3 text-sm text-body">No managed-project evidence is represented in this foundation. Runtime readiness does not establish coverage or correctness of a managed system.</p>
                <p class="mt-3 text-sm text-body">The planned model connects components and behaviours to verification definitions, executions, original artifacts and traceable assessments.</p>
            </section>
            <section aria-labelledby="interfaces-heading" class="rounded-xl border border-default bg-neutral-primary p-5 md:p-6">
                <h2 id="interfaces-heading" class="text-lg font-semibold text-heading">Agent and human interactions</h2>
                <p class="mt-3 text-sm text-body">The web application and MCP server use shared application services. A persistent runtime probe exercises the database, worker and artifact path.</p>
                <p class="mt-3 text-sm text-body">MCP connection instructions and probe commands are documented in the project README.</p>
            </section>
        </div>
    </div>
{% endblock %}
