{%- props
    ## 'info'|'success'|'warning'|'danger' The kind of message, shown by the icon and color.
    variant = 'info',
    ## int Milliseconds before the toast dismisses itself, 0 to keep it until closed. Paused while hovered or focused.
    timeout = 5000,
    ## string The accessible name of the close button.
    closeLabel = 'Close'
-%}
{#- the attributes given, in any case: no `on…` handler, `srcset` or `ping`; `href` and `formaction` through the link policy, `src` through the image policy -#}
{%- set attributes = attributes.without(...attributes.all|keys).defaults(attributes.all|filter((value, name) => not ((name ~ '')|trim("\x00..\x20", 'left')|lower matches '/^(?:on|(?:srcset|ping)$)/'))|map((value, name) => (name ~ '')|trim("\x00..\x20", 'left')|lower not in ['href', 'formaction', 'src'] or value is null or value is same as(false) or value is same as(true) ? value : ((value ~ '')|replace({"\t": '', "\n": '', "\r": ''})|trim("\x00..\x20", 'left') matches ((name ~ '')|trim("\x00..\x20", 'left')|lower == 'src' ? '/^(?:https?:|(?![a-z][a-z0-9+.-]*:))/i' : '/^(?:(?:https?|mailto|tel):|(?![a-z][a-z0-9+.-]*:))/i') ? value ~ '' : ((name ~ '')|trim("\x00..\x20", 'left')|lower == 'src' ? null : '#')))) -%}
{%- set style = html_cva(
    base: 'pointer-events-auto flex w-full items-start gap-3 rounded-base border border-default bg-neutral-primary-soft p-4 text-sm text-body shadow-lg transition-opacity duration-300 motion-reduce:transition-none!',
    variants: {variant: {info: '', success: '', warning: '', danger: ''}},
) -%}
{%- set icon = html_cva(
    base: 'inline-flex size-8 shrink-0 items-center justify-center rounded-base',
    variants: {
        variant: {
            info: 'bg-brand-softer text-fg-brand-strong',
            success: 'bg-success-soft text-fg-success-strong',
            warning: 'bg-warning-soft text-fg-warning',
            danger: 'bg-danger-soft text-fg-danger-strong',
        },
    },
) -%}
{#- full icon names, so `ux:icons:lock` finds them -#}
{%- set icons = {info: 'flowbite:info-circle-solid', success: 'flowbite:check-circle-solid', warning: 'flowbite:exclamation-circle-solid', danger: 'flowbite:close-circle-solid'} -%}
<div
    {%- if variant == 'danger' %} role="alert"{% endif %}
    data-toast-timeout-value="{{ timeout }}"
    {{ attributes.defaults({
        class: style.apply({variant: variant})|tailwind_classes,
        'data-controller': 'toast',
        'data-action': 'mouseenter->toast#pause mouseleave->toast#resume focusin->toast#pause focusout->toast#resume',
    }) }}
>
    <span class="{{ icon.apply({variant: variant}) }}">
        <twig:ux:icon name="{{ icons[variant] }}" class="size-5" aria-hidden="true" />
    </span>
    <div class="min-w-0 flex-1 pt-1.5">
        {##- The message. -#}
        {%- block content %}{% endblock -%}
    </div>
    <button type="button" aria-label="{{ closeLabel }}" data-action="toast#close" class="-m-1.5 inline-flex size-8 shrink-0 items-center justify-center rounded-base text-body hover:bg-neutral-secondary-medium hover:text-heading focus:outline-none focus:ring-2 focus:ring-brand-medium">
        <twig:ux:icon name="flowbite:close-outline" class="size-4" aria-hidden="true" />
    </button>
</div>
