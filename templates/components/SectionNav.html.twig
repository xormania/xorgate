{%- props
    ## string The accessible name of the navigation landmark.
    label = 'Sections',
    ## 'responsive'|'vertical'|'horizontal' A strip that scrolls sideways below the `lg` breakpoint and a column from it, always a column, or always a strip.
    orientation = 'responsive'
-%}
{#- the attributes given, in any case: no `on…` handler, `srcset` or `ping`; `href` and `formaction` through the link policy, `src` through the image policy -#}
{%- set attributes = attributes.without(...attributes.all|keys).defaults(attributes.all|filter((value, name) => not ((name ~ '')|trim("\x00..\x20", 'left')|lower matches '/^(?:on|(?:srcset|ping)$)/'))|map((value, name) => (name ~ '')|trim("\x00..\x20", 'left')|lower not in ['href', 'formaction', 'src'] or value is null or value is same as(false) or value is same as(true) ? value : ((value ~ '')|replace({"\t": '', "\n": '', "\r": ''})|trim("\x00..\x20", 'left') matches ((name ~ '')|trim("\x00..\x20", 'left')|lower == 'src' ? '/^(?:https?:|(?![a-z][a-z0-9+.-]*:))/i' : '/^(?:(?:https?|mailto|tel):|(?![a-z][a-z0-9+.-]*:))/i') ? value ~ '' : ((name ~ '')|trim("\x00..\x20", 'left')|lower == 'src' ? null : '#')))) -%}
{%- set style = html_cva(
    base: 'flex gap-1 overflow-x-auto',
    variants: {
        orientation: {
            responsive: 'lg:flex-col',
            vertical: 'flex-col',
            horizontal: '',
        },
    },
) -%}
{%- set orientation = orientation in ['responsive', 'vertical', 'horizontal'] ? orientation : 'responsive' -%}
<nav aria-label="{{ label }}"
    {{ attributes.defaults({
        class: 'min-w-0'|tailwind_classes,
        'data-controller': 'section-nav',
    }) }}
>
    <ul data-section-nav-target="list" class="{{ style.apply({orientation: orientation})|tailwind_classes }}">
        {##- The sections: one `SectionNav:Item` link per page. -#}
        {%- block content %}{% endblock -%}
    </ul>
</nav>
