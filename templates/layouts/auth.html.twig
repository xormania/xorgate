{% extends 'layouts/base.html.twig' %}

{##- The body classes of this layout. -#}
{% block body_class %}min-h-svh bg-neutral-secondary-soft text-body antialiased{% endblock %}

{##- The layout around the page content. -#}
{% block body %}
    <main class="flex min-h-svh flex-col items-center justify-center gap-6 p-6 md:p-10!">
        <div class="flex items-center gap-2 text-lg font-semibold text-heading">
            {##- The brand above the card. -#}
            {%- block brand %}{% endblock -%}
        </div>
        <div class="w-full max-w-sm">
            {##- The form, typically the `login`, `signup` or `forgot-password` block. -#}
            {%- block content %}{% endblock -%}
        </div>
    </main>
{% endblock %}
