{% extends 'layouts/management.html.twig' %}
{% form_theme form 'form/flowbite_layout.html.twig' %}

{% block title %}Xorgate · Upload report{% endblock %}
{% block page_title %}Upload report{% endblock %}
{% block page_description %}{{ project.name }} · {{ execution.execution_id }}{% endblock %}
{% block page_before %}<a href="{{ path('app_execution_show', {projectId: project.project_id, executionId: execution.execution_id}) }}" class="mb-2 inline-block text-sm text-fg-brand hover:underline">Back to execution context</a>{% endblock %}

{% block content %}
    <div class="space-y-6" data-xorgate-report-upload="{{ execution.execution_id }}">
        <twig:Card data-xorgate-intake-capacity="{{ capacity.status }}">
            <twig:Card:Header><twig:Card:Title as="h2">Shared intake capacity</twig:Card:Title></twig:Card:Header>
            <twig:Card:Content>
                <p class="mb-4 text-sm text-body">{{ capacity.status == 'limited' ? 'New intake is limited.' : 'New intake can be admitted within these installation limits.' }} Existing request replays remain available. Admission is checked again when an upload is submitted.</p>
                {% if capacity.reason is not null %}<p class="mb-4 text-sm text-body">Limit reason: {{ capacity.reason }}</p>{% endif %}
                <dl class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    <div><dt class="text-sm font-medium text-heading">Pending operations</dt><dd class="mt-1 text-sm text-body" data-xorgate-intake-pending="{{ capacity.usage.pending }}">{{ capacity.usage.pending }} / {{ capacity.limits.pending }}</dd></div>
                    <div><dt class="text-sm font-medium text-heading">Retained operations</dt><dd class="mt-1 text-sm text-body">{{ capacity.usage.retained }} / {{ capacity.limits.retained }}</dd></div>
                    <div><dt class="text-sm font-medium text-heading">New operations in the last minute</dt><dd class="mt-1 text-sm text-body">{{ capacity.usage.created_last_minute }} / {{ capacity.limits.new_per_minute }}</dd></div>
                    <div><dt class="text-sm font-medium text-heading">Bytes referenced by retained artifacts</dt><dd class="mt-1 text-sm text-body">{{ capacity.usage.reference_bytes|number_format }} / {{ capacity.limits.storage_bytes|number_format }} bytes</dd></div>
                    <div><dt class="text-sm font-medium text-heading">Measured original blobs</dt><dd class="mt-1 text-sm text-body">{{ capacity.usage.blob_bytes|number_format }} bytes / {{ capacity.usage.blob_files }} files</dd></div>
                    <div><dt class="text-sm font-medium text-heading">Measured staged uploads</dt><dd class="mt-1 text-sm text-body">{{ capacity.usage.staging_bytes|number_format }} bytes / {{ capacity.usage.staging_files }} files</dd></div>
                    <div><dt class="text-sm font-medium text-heading">Global physical storage</dt><dd class="mt-1 text-sm text-body">{{ capacity.usage.physical_bytes|number_format }} / {{ capacity.limits.storage_bytes|number_format }} bytes</dd></div>
                    <div><dt class="text-sm font-medium text-heading">Global physical files</dt><dd class="mt-1 text-sm text-body">{{ capacity.usage.physical_files }} / {{ capacity.limits.blob_files }}</dd></div>
                </dl>
                <p class="mt-4 text-sm text-body">The physical budget includes staged uploads and original blobs; shared stored bytes are counted once.</p>
                {% if capacity.usage.blob_scan_truncated %}<p class="mt-4 text-sm text-body">The storage scan reached its bound; measured bytes and file counts are partial.</p>{% endif %}
            </twig:Card:Content>
        </twig:Card>
        <twig:Card class="max-w-3xl">
            <twig:Card:Header><twig:Card:Title as="h2">Import an existing report</twig:Card:Title></twig:Card:Header>
            <twig:Card:Content>
                <p class="mb-4 text-sm text-body">The original bytes are retained and parsing runs asynchronously. Uploading a report does not execute tests or change the execution context. The upload limit is {{ max_bytes|number_format }} bytes.</p>
                <p class="mb-5 text-sm text-body">Verify the source fields against the report's actual origin. At least one known field must match this execution. Unknown-only execution context cannot establish this source check; record an execution with known source context first.</p>
                {{ form_start(form, {attr: {id: 'report_upload', novalidate: true}, enctype: 'multipart/form-data'}) }}
                    {{ form_errors(form) }}
                    {{ form_errors(form.request_id) }}
                    {{ form_row(form.report_role) }}
                    {{ form_row(form.format) }}
                    {{ form_row(form.report) }}
                    {{ form_row(form.source) }}
                    {{ form_row(form.confirm_context) }}
                    {% if form.vars.submitted %}<p class="mb-5 text-sm text-body">The selected file is not retained in this form. Select it again before retrying.</p>{% endif %}
                    <div class="flex flex-wrap gap-3">
                        <twig:Button type="submit">Upload for intake</twig:Button>
                        <twig:Button as="a" variant="outline" href="{{ path('app_execution_evidence', {projectId: project.project_id, executionId: execution.execution_id}) }}">View report imports</twig:Button>
                    </div>
                {{ form_end(form) }}
            </twig:Card:Content>
        </twig:Card>
        {% include 'reports/_provenance.html.twig' with {execution: execution} only %}
    </div>
{% endblock %}
