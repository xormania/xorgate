#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ $# != 0 ]]; then
    echo 'Usage: ./bin/check-dev' >&2
    exit 2
fi

# Native Mate reads the application's compiled container and opt-in profiler storage.
docker compose exec -T php php bin/console cache:warmup --env=dev
python3 tests/smoke/development.py mate
python3 tests/smoke/development.py profiler
